<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">


    <!-- ═══════════ Empty State ═══════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:visibility="visible">

        <!-- ── Back Button (Empty State) ── -->
        <ImageButton
            android:id="@+id/btnBackEmpty"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            app:tint="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp" />

        <!-- ── Arc container: fixed 200dp, 28dp away from status bar ── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/arcContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- BTC: puncak tengah – arc(90°) R=115dp -->
            <!-- center=(50%, 85dp) → Hb=0.5, Vb=85/200=0.425 -->
            <FrameLayout
                android:id="@+id/floatBtc"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FF1A1A2E"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintVertical_bias="0.351">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_btc" />
            </FrameLayout>

            <!-- ETH: kiri atas – arc(122.5°) → Hb=0.328, Vb=0.515 -->
            <FrameLayout
                android:id="@+id/floatEth"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FF1A1A2E"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.248"
                app:layout_constraintVertical_bias="0.467">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_eth" />
            </FrameLayout>

            <!-- SOL: kanan atas – arc(57.5°) → Hb=0.672, Vb=0.515 -->
            <FrameLayout
                android:id="@+id/floatSol"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FF1A1A2E"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.752"
                app:layout_constraintVertical_bias="0.467">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sol" />
            </FrameLayout>

            <!-- BNB: kiri bawah – arc(155°) → Hb=0.211, Vb=0.757 -->
            <FrameLayout
                android:id="@+id/floatBnb"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FF1A1A2E"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.064"
                app:layout_constraintVertical_bias="0.783">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bnb" />
            </FrameLayout>

            <!-- USDT: kanan bawah – arc(25°) → Hb=0.789, Vb=0.757 -->
            <FrameLayout
                android:id="@+id/floatUsdt"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_button"
                android:backgroundTint="#FF1A1A2E"
                android:elevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.936"
                app:layout_constraintVertical_bias="0.783">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_usdt" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ── Hero wallet icon (center) ── -->
        <FrameLayout
            android:id="@+id/heroContainer"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#207C4DFF"
            android:elevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/arcContainer"
            app:layout_constraintBottom_toTopOf="@+id/tvWelcomeTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.05">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:src="@drawable/wallet_24"
                android:tint="@color/wallet_accent" />
        </FrameLayout>

        <!-- ── Title ── -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallet_empty_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@+id/heroContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tvWelcomeSubtitle" />

        <!-- ── Subtitle ── -->
        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/wallet_empty_desc"
            android:textColor="@color/icon_inactive"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="40dp"
            app:layout_constraintTop_toBottomOf="@+id/tvWelcomeTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnCreateWallet" />

        <!-- ── Create Wallet Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateWallet"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:text="@string/wallet_create"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:backgroundTint="@color/wallet_accent"
            android:layout_marginHorizontal="28dp"
            android:layout_marginBottom="12dp"
            app:cornerRadius="20dp"
            app:elevation="0dp"
            app:layout_constraintBottom_toTopOf="@+id/btnImportWallet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Import Wallet Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportWallet"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallet_import"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:paddingVertical="12dp"
            android:layout_marginBottom="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════════ Wallet Loaded State ═══════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutWalletInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Top Bar ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wallet."
                    android:fontFamily="@font/codega"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/btnBack"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.1" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_more"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="#FFFFFF" />
            </RelativeLayout>

            <!-- ── Balance Card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_wallet_card"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah Saldo"
                    android:textColor="@color/icon_inactive"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTotalBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/text_primary"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.03"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvBalanceChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/wallet_green"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="28dp" />

                <!-- Action Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Send -->
                    <LinearLayout
                        android:id="@+id/btnSend"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_circle_button"
                            android:backgroundTint="#207C4DFF">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_action_send"
                                android:layout_gravity="center"
                                android:tint="@color/wallet_accent" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kirim"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- Receive -->
                    <LinearLayout
                        android:id="@+id/btnReceive"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_circle_button"
                            android:backgroundTint="#207C4DFF">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_action_receive"
                                android:layout_gravity="center"
                                android:tint="@color/wallet_accent" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terima"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <!-- History -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_circle_button"
                            android:backgroundTint="#1A7C4DFF">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_action_history"
                                android:layout_gravity="center"
                                android:tint="@color/icon_inactive" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Riwayat"
                            android:textColor="@color/icon_inactive"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- ── Assets Section ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aset"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:paddingBottom="12dp"
                android:letterSpacing="-0.01" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAssets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
