<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground">

    <!-- Coin Icon with colored background -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#1A7C4DFF">

        <ImageView
            android:id="@+id/ivAssetIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            tools:src="@drawable/ic_btc" />
    </FrameLayout>

    <!-- Left: symbol + name + price -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/tvAssetSymbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="BTC"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/tvAssetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Bitcoin"
                android:textColor="@color/icon_inactive"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_search_input"
                android:backgroundTint="#14FFFFFF"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAssetPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="$96,326.50  +2.22%"
            android:textColor="@color/icon_inactive"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Right: balance + USD value -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvAssetBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="0.3594"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvAssetValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="$34,623.37"
            android:textColor="@color/icon_inactive"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
