<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Model icon container -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#1A1A2E"
        android:layout_marginEnd="14dp">

        <ImageView
            android:id="@+id/ivModelIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_qwen"
            android:tint="#7B8CFF" />
    </FrameLayout>

    <!-- Model name + description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row: name + speed chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpeedChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_speed_chip"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvModelDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Checkmark for selected -->
    <ImageView
        android:id="@+id/ivCheckmark"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_verified_24px"
        android:tint="#7B8CFF"
        android:visibility="gone" />

</LinearLayout>
